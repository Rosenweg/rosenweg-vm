# vm-gateway: einziger Weg der App "Rosenweg Virtuelle Computer" zu Proxmox.
# Laeuft ohne Sonderrechte: WireGuard und Netzstapel im Prozess, kein
# CAP_NET_ADMIN, keine Schnittstelle, kein Weiterleiten.
[Unit]
Description=Rosenweg vm-gateway (App-Tunnel zu Proxmox)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/vm-gateway/env
ExecStart=/opt/vm-gateway/vm-gateway
User=vm-gateway
Group=vm-gateway
StateDirectory=vm-gateway
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3

# Haertung: der Dienst braucht nur Netz und sein Zustandsverzeichnis.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK und AF_UNIX braucht wireguard-go (StdNetBind: Schnittstellen-
# und Adressabfrage beim Binden des UDP-Sockets). Ohne sie scheitert der
# Start mit "address family not supported by protocol".
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
