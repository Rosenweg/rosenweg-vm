<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Entwicklungsbau ohne Sandbox: rwspice laedt spice-glib aus MacPorts
	     (/opt/local), das die Sandbox nicht lesen laesst. Der ausgelieferte Bau
	     buendelt die Bibliotheken in Contents/Frameworks und laeuft mit Sandbox
	     (Release.entitlements). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Ruecksprung der Anmeldung auf localhost und lokaler Tunnel-Proxy. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.usb</key>
	<true/>
	<!-- Ordner freigeben: die Person waehlt den Ordner selbst. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Anmeldeschirm: Rosenweg-Karte ueber USB-NFC-Leser (PC/SC, rosenweg_basis) -->
	<key>com.apple.security.smartcard</key>
	<true/>
</dict>
</plist>
